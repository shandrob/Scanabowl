# Copy this file to ".env.local" for local testing. On Vercel, add the same names under
# Project -> Settings -> Environment Variables. Nothing here is required to run the site:
# every missing value degrades gracefully (see README.md).

# ---- Website ---------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.scanabowl.com
NEXT_PUBLIC_CONTACT_EMAIL=scanabowl@gmail.com

# ---- bol.com affiliate -----------------------------------------------------------------------
# Your "site id" (siteId) from the bol.com Partner Platform. Empty = links go to bol.com without
# commission tracking.
NEXT_PUBLIC_BOL_SITE_ID=

# ---- Forms (suggestions, brand submissions, corrections, contact) -----------------------------
# Get a free API key at https://resend.com. Without it the forms show a "mail us instead" message.
RESEND_API_KEY=
# where the form messages are delivered
MAIL_TO=scanabowl@gmail.com
# sender; use an address on a domain you verified in Resend, e.g. "Scanabowl <noreply@scanabowl.com>"
MAIL_FROM=Scanabowl <onboarding@resend.dev>

# ---- Company details shown in the footer and legal pages (Dutch law requires KvK / BTW) ------
NEXT_PUBLIC_KVK=
NEXT_PUBLIC_VAT=
NEXT_PUBLIC_ADDRESS=
